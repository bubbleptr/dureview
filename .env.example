# Copy to .env and fill in. Do not commit secrets.

DUREVIEW_WEBHOOK_SECRET=replace-with-a-long-random-string
DUREVIEW_PROVIDER=openai-codex
DUREVIEW_MODEL=gpt-5.5

# GitHub App (preferred). The private key may be the PEM itself or a path.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Or a personal access token instead of an App.
# GITHUB_TOKEN=

# Alternative to Codex OAuth. Requires DUREVIEW_PROVIDER=openai.
# OPENAI_API_KEY=

# Status page on GET / and GET /ui. Unset leaves the page disabled (404).
# The value is the Basic-auth password (any username) or a Bearer token.
# DUREVIEW_UI_TOKEN=
