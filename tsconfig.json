{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "react"]
  },
  "include": ["src"],
  "exclude": [
    "src/routes",
    "src/router.tsx",
    "src/server-entry.ts",
    "src/ui/list-fn.ts",
    "src/ui/detail-fn.ts",
    "src/ui/file-fn.ts",
    "src/ui/settings-fn.ts",
    "src/routeTree.gen.ts",
    "src/styles.css"
  ]
}
