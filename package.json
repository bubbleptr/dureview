{
  "name": "dureview",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable adversarial pull request review bot on Pi Durable.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "dureview": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -p tsconfig.json && vite build && node scripts/smoke-pi-ai-external.mjs",
    "smoke:server": "node scripts/smoke-pi-ai-external.mjs",
    "test": "vitest run",
    "bench:diff": "node scripts/bench/run.mjs",
    "e2e": "vitest run test/e2e.test.ts",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@pierre/diffs": "1.6.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "nitro": "3.0.260903-beta",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
